    <dashboard enable-sort-zone-taborder='true' name='Operational Drivers: Discounts and Volume Efficiency'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Operational Drivers: Discounts and Volume Efficiency </run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://public.tableau.com/workbooks/Project-A_Profitability_Diagnostics_twbx/OperationalDriversDiscountsandVolumeEfficiency?rev=' id='125913525' path='/workbooks/Project-A_Profitability_Diagnostics_twbx' revision='' />
      <style />
      <size maxheight='860' maxwidth='650' minheight='560' minwidth='420' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97658' id='24' param='horz' type-v2='layout-flow' w='97538' x='1231' y='1171'>
            <zone h='97658' id='12' param='vert' type-v2='layout-flow' w='97538' x='1231' y='1171'>
              <zone h='5417' id='14' type-v2='title' w='97538' x='1231' y='1171'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='9663' id='25' type-v2='text' w='97538' x='1231' y='6588'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Discounts Are Strongly Linked to Margin Decline</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Æ </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Higher average discounts are associated with sharply lower profit margins, especially in Furniture and some Technology sub-categories. This suggests pricing strategy, not demand, is a major driver of losses. </run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='82578' id='8' param='vert' type-v2='layout-flow' w='97538' x='1231' y='16251'>
                <zone h='82578' id='6' type-v2='layout-basic' w='97538' x='1231' y='16251'>
                  <zone h='44708' id='9' type-v2='layout-basic' w='97538' x='1231' y='54121'>
                    <zone h='44708' id='10' param='vert' type-v2='layout-flow' w='97538' x='1231' y='54121'>
                      <zone h='44708' id='13' type-v2='layout-basic' w='97538' x='1231' y='54121'>
                        <zone h='44708' id='18' param='horz' type-v2='layout-flow' w='97538' x='1231' y='54121'>
                          <zone h='44708' id='19' name='Volume VS Efficiency by Category' show-title='false' w='48769' x='1231' y='54121'>
                            <layout-cache has-max-size-w='true' maxwidth='604' minwidth='604' type-h='fixed' type-w='scalable' />
                            <zone-style>
                              <format attr='border-color' value='#000000' />
                              <format attr='border-style' value='none' />
                              <format attr='border-width' value='0' />
                              <format attr='margin' value='4' />
                            </zone-style>
                          </zone>
                          <zone h='44708' id='22' name='Volume VS Efficiency Sub-Category' show-title='false' w='48769' x='50000' y='54121'>
                            <layout-cache has-max-size-w='true' maxwidth='607' minwidth='607' type-h='fixed' type-w='scalable' />
                            <zone-style>
                              <format attr='border-color' value='#000000' />
                              <format attr='border-style' value='none' />
                              <format attr='border-width' value='0' />
                              <format attr='margin' value='4' />
                            </zone-style>
                          </zone>
                        </zone>
                      </zone>
                    </zone>
                  </zone>
                  <zone h='27518' id='15' name='Discount Impact on Profit Margin' show-title='false' w='97538' x='1231' y='16251'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='10352' id='26' type-v2='text' w='97538' x='1231' y='43769'>
                    <formatted-text>
                      <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Volume Does Not Equal Efficiency</run>
                      <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Æ </run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Technology combines high sales with strong margins, while Furniture generates comparable volume with significantly weaker profitability. Several high-volume sub-categories operate below average margins, indicating structural cost or discounting issues. </run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>

      <aliases enabled='yes' />
      <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_0857987247722496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Positive Profit Only' datatype='real' name='[Calculation_0857987605450755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt; 0 THEN &#10;SUM([Profit]) ELSE 0 END' />
      </column>
      <column caption=' Positive Profit' datatype='real' name='[Calculation_0857987931009030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt; 0 THEN SUM([Profit]) END' />
      </column>
      <column caption='Total Positive Profit  (Window)' datatype='real' name='[Calculation_0857987931115527]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(&#10;    IF SUM([Profit]) &gt; 0 THEN SUM([Profit]) END&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Running % Positive Profit' datatype='real' default-format='p0.00%' name='[Calculation_0857987931926536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(&#10;    IF SUM([Profit]) &gt; 0 THEN SUM([Profit]) END&#10;)&#10;/&#10;WINDOW_SUM(&#10;    IF SUM([Profit]) &gt; 0 THEN SUM([Profit]) END&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sub-Category (Positive Only)' datatype='string' name='[Calculation_0857988291289097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &gt; 0 THEN [Sub-Category] END' />
      </column>
      <column caption=' Running % Positive Profit' datatype='real' name='[Calculation_0857988294119434]' role='measure' type='quantitative'>
